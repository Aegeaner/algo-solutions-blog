---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

import placeholder1 from '../../assets/blog-placeholder-1.jpg';
import placeholder2 from '../../assets/blog-placeholder-2.jpg';
import placeholder3 from '../../assets/blog-placeholder-3.jpg';
import placeholder4 from '../../assets/blog-placeholder-4.jpg';
import placeholder5 from '../../assets/blog-placeholder-5.jpg';

const placeholders = [placeholder1, placeholder2, placeholder3, placeholder4, placeholder5];

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const base = import.meta.env.BASE_URL;

function resolveHref(href: string | URL) {
	const hrefStr = typeof href === 'string' ? href : href instanceof URL ? href.toString() : '/';
	return hrefStr.startsWith('http') ? hrefStr : `${base}${hrefStr.replace(/^\/+/, '')}`;
}

function getCode(s: string) {
	let hash = 0;
	if (s.length === 0) return hash;
	for (let i = 0; i < s.length; i++) {
		const char = s.charCodeAt(i);
		hash = ((hash << 5) - hash) + char;
		hash = hash & hash;
	}
	return Math.abs(hash);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
				background: #fff;
				border-radius: 12px;
				overflow: hidden;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			ul li:hover {
				transform: translateY(-4px);
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 2rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
				height: auto;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				margin-bottom: 1rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px 12px 0 0;
				width: 100%;
				height: 200px;
				object-fit: cover;
			}
			ul li a {
				display: block;
			}
			ul li:hover img {
				/* box-shadow handled by li:hover now */
			}
			ul li:hover .title {
				color: rgb(var(--accent));
			}
			.post-content {
				padding: 1rem;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-family: 'Arvo', serif;
				font-size: 1.5rem;
			}
			.date {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.description {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			ul li:first-child .title {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
			}
			ul li:first-child .description {
				font-size: 1.2rem;
				max-width: 800px;
				margin: 0 auto;
			}
			@media (max-width: 720px) {
				ul {
					gap: 1.5rem;
				}
				ul li {
					width: 100%;
					text-align: left;
				}
				ul li:first-child {
					margin-bottom: 1.5rem;
					text-align: left;
				}
				ul li:first-child .title {
					font-size: 1.8rem;
				}
				ul li:first-child .description {
					font-size: 1rem;
					margin: 0;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => {
							const targetImage = placeholders[getCode(post.id) % placeholders.length];
							return (
							<li>
								<a href={resolveHref(`/blog/${post.id}/`)}>
									<Image width={720} height={360} src={targetImage} alt="" />
									<div class="post-content">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h4 class="title">{post.data.title}</h4>
										<p class="description">
											{post.data.description}
										</p>
									</div>
								</a>
							</li>
						)})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
