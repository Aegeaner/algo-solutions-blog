---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
const base = import.meta.env.BASE_URL;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith("/en");

// 生成切换链接
let switchLangUrl;
if (currentPath.includes("/blog")) {
  // 博客相关页面切换语言时回到首页
  switchLangUrl = isEnglish ? "/" : "/en/";
} else if (isEnglish) {
  switchLangUrl = currentPath.replace("/en", "") || "/";
} else {
  switchLangUrl = "/en" + currentPath;
}
---

<header>
  <nav>
    <h2><a href="/">{SITE_TITLE}</a></h2>
    <div class="internal-links">
      <HeaderLink href={`${base}`}>Home</HeaderLink>
      <HeaderLink href={`/blog`}>Blog</HeaderLink>
      <HeaderLink href={`${base}about`}>About</HeaderLink>
      <HeaderLink href={switchLangUrl}
        >{isEnglish ? "中文" : "English"}</HeaderLink
      >
    </div>
    <div class="social-links">
      <a href="https://www.nowcoder.com/users/552530" target="_blank">
        <span class="sr-only">Follow Aegeaner on NowCoder</span>
        <svg
          viewBox="0 0 200 200"
          aria-hidden="true"
          width="32"
          height="32"
          astro-icon="social/nowcoder"
        >
          <path
            fill="currentColor"
            d="M100 10C50.294 10 10 50.294 10 100s40.294 90 90 90 90-40.294 90-90S149.706 10 100 10zm42.5 130h-85V60h85v80z"
          ></path>
          <circle fill="currentColor" cx="75" cy="85" r="8"></circle>
          <circle fill="currentColor" cx="125" cy="85" r="8"></circle>
          <path
            fill="currentColor"
            d="M75 110c0 13.807 11.193 25 25 25s25-11.193 25-25H75z"></path>
        </svg>
      </a>
      <a href="https://leetcode.cn/u/aegeaner" target="_blank">
        <span class="sr-only">Follow Aegeaner on LeetCode</span>
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          width="32"
          height="32"
          astro-icon="social/leetcode"
        >
          <path
            fill="currentColor"
            d="M13.483 0a1.374 1.374 0 0 0-.961.438L7.116 6.226l-3.854 4.126a5.266 5.266 0 0 0-1.209 2.104 5.35 5.35 0 0 0-.125.513 5.527 5.527 0 0 0 .062 2.362 5.83 5.83 0 0 0 .349 1.017 5.938 5.938 0 0 0 1.271 1.818l4.277 4.193.039.038c2.248 2.165 5.852 2.133 8.063-.074l2.396-2.392c.54-.54.54-1.414.003-1.955a1.378 1.378 0 0 0-1.951-.003l-2.396 2.392a3.021 3.021 0 0 1-4.205.038l-.02-.019-4.276-4.193c-.652-.64-.972-1.469-.948-2.263a2.68 2.68 0 0 1 .066-.523 2.545 2.545 0 0 1 .619-1.164L9.13 8.114c1.058-1.134 3.204-1.27 4.43-.278l3.501 2.831c.593.48 1.461.387 1.94-.207a1.384 1.384 0 0 0-.207-1.943l-3.5-2.831c-.8-.647-1.766-1.045-2.774-1.202z"
          ></path>
        </svg>
      </a>
      <a href="https://github.com/Aegeaner" target="_blank">
        <span class="sr-only">Go to Aegeaner's GitHub profile</span>
        <svg
          viewBox="0 0 16 16"
          aria-hidden="true"
          width="32"
          height="32"
          astro-icon="social/github"
          ><path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .social-links,
  .social-links a {
    display: flex;
  }
  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
  }
</style>
